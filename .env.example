# Bördesnack24 — Beispiel-Umgebungsvariablen
# Kopieren nach .env (NICHT committen). Nur Client-sichere Werte hier.

# Supabase (clientseitig: nur URL + anon/publishable key)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Observability (clientseitig)
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.posthog.com

# Google Maps (Automatenfinder)
GOOGLE_MAPS_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# SERVER-ONLY — NICHT in den Client! Als Supabase Function Secrets setzen:
#   supabase secrets set KEY=VALUE
# ──────────────────────────────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY=
# SEVDESK_API_TOKEN=
# NAYAX_API_KEY=
# NAYAX_WEBHOOK_SECRET=
# FCM_SERVER_KEY=

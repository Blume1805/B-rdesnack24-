# ──────────────────────────────────────────────────────────────────────────
# Bördesnack24 — Monorepo .gitignore
# ──────────────────────────────────────────────────────────────────────────

# Secrets / Env (NIEMALS committen)
.env
.env.*
!.env.example
*.local
config.*.php
!config.*.example.php
**/secrets/*
!**/secrets/.gitkeep
*.pem
*.key
*.keystore
*.jks
key.properties

# Flutter dart-define Umgebungsdateien (Beispiele bleiben)
apps/*/env/*.json
!apps/*/env/*.example.json

# Flutter / Dart (gilt fuer beide Apps und das gemeinsame Paket)
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
apps/*/build/
packages/*/build/
**/.packages
apps/*/pubspec.lock
packages/*/pubspec.lock
**/*.g.dart
**/*.freezed.dart
**/*.config.dart
**/generated_plugin_registrant.dart
coverage/
*.lcov

# Android
apps/*/android/.gradle/
apps/*/android/app/debug/
apps/*/android/app/profile/
apps/*/android/app/release/
apps/*/android/local.properties

# iOS
apps/*/ios/Pods/
apps/*/ios/.symlinks/
apps/*/ios/Flutter/Flutter.framework
apps/*/ios/Flutter/Flutter.podspec
**/*.xcworkspace/xcuserdata/
**/xcuserdata/

# Supabase
supabase/.branches/
supabase/.temp/
supabase/.env

# Node (Edge Functions Tooling, Skripte)
node_modules/
npm-debug.log*

# IDE / OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.recommended.json
.DS_Store
Thumbs.db
*.swp

# Claude Code local settings
.claude/settings.local.json

# Generierte Lokalisierung (via flutter gen-l10n im gemeinsamen Paket)
packages/bs24_kern/lib/l10n/generated/
/assets/
